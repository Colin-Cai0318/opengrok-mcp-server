{
  "manifest_version": 3,
  "name": "OpenGrok Cookie Sync",
  "version": "2.2.0",
  "description": "Automatically synchronize cookies for the approved OpenGrok instances to the local MCP helper.",
  "permissions": ["cookies", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "OpenGrok Cookie Sync" }
}
